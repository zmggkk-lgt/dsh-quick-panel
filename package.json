{
  "name": "@local/quick-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Adds a Quick Panel entry to the left sidebar with a live clock and quick actions.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "sidebar",
    "panel"
  ],
  "homepage": "https://github.com/zmggkk-lgt/dsh-quick-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmggkk-lgt/dsh-quick-panel.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
